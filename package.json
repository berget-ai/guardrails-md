{
  "name": "@bergetai/opencode-guardrails-md",
  "version": "0.8.0",
  "description": "guardrails.md gate for opencode, pi and Claude Code (hooks module) + git pre-commit CLI: a System One decision model (TypeSafe Jev) judges every bash command and staged commit before it runs \u2014 destructive / credentials / guardrails.md policy",
  "type": "module",
  "exports": {
    ".": "./adapters/opencode.ts",
    "./opencode": "./adapters/opencode.ts",
    "./pi": "./adapters/pi.ts"
  },
  "bin": {
    "guardrails-md": "./cli.js"
  },
  "files": [
    "core.ts",
    "adapters/opencode.ts",
    "adapters/pi.ts",
    "cli.ts",
    "cli.js",
    ".claude-plugin/plugin.json",
    "hooks/hooks.json",
    "hooks/register.ts",
    "README.md",
    "guardrails.example.md",
    "LICENSE"
  ],
  "keywords": [
    "guardrails",
    "cli",
    "pre-commit",
    "git",
    "decision-model",
    "systemone",
    "safety",
    "opencode",
    "pi",
    "claude-code"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berget-ai/guardrails-md.git"
  },
  "bugs": {
    "url": "https://github.com/berget-ai/guardrails-md/issues"
  },
  "homepage": "https://github.com/berget-ai/guardrails-md#readme",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}