{
  "name": "@bergetai/opencode-guardrails-md",
  "version": "0.5.0",
  "description": "guardrails.md gate for opencode and pi: a System One decision model (TypeSafe Jev) judges every bash command before it runs — destructive / credentials / guardrails.md policy",
  "type": "module",
  "exports": {
    ".": "./adapters/opencode.ts"
  },
  "files": [
    "core.ts",
    "adapters/opencode.ts",
    "adapters/pi.ts",
    "README.md",
    "guardrails.example.md"
  ],
  "pi": {
    "extensions": [
      "./adapters/pi.ts"
    ]
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pi",
    "systemone",
    "safety",
    "guardrails",
    "bash",
    "security"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berget-ai/guardrails-md.git"
  },
  "bugs": {
    "url": "https://github.com/berget-ai/guardrails-md/issues"
  },
  "homepage": "https://github.com/berget-ai/guardrails-md#readme",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
